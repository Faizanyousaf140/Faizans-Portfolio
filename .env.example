# Set this to your confirmed, deployed portfolio domain to enable canonical URLs.
NEXT_PUBLIC_SITE_URL=https://faizanyousafs-portfolio.vercel.app

# EmailJS browser identifiers. Use the existing template's from_name,
# from_email, subject and message fields. These are public client identifiers.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# PostHog public project ingestion key, never a personal API key.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
